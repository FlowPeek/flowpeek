<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleLocalizations</key>
    <array><string>en</string><string>ko</string></array>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 FlowPeek</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- GitHub redirects releases/latest/download/<asset> to the newest release, so this URL is
         stable while the release workflow re-uploads appcast.xml on every tag. No extra hosting. -->
    <key>SUFeedURL</key>
    <string>https://github.com/FlowPeek/flowpeek/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>JxNKL7N4ydZGNSFrjODUHBpt+746seri2LLtfnVxQgk=</string>
    <!-- Three hours. Sparkle enforces a floor of one hour in a release build and quietly raises
         anything smaller, so this is well inside what it will honour; a day was long enough that a
         Mac left on all day could sit a release behind for most of it. Each check is one request
         for a small XML file, and an update that is found is fetched quietly and put in place the
         next time FlowPeek starts, so a shorter interval costs the reader nothing. -->
    <key>SUScheduledCheckInterval</key>
    <integer>10800</integer>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <!-- macOS ships no type for a Mermaid file, so FlowPeek declares one. Conforming to
                 plain text keeps every editor able to open it; the Quick Look extension asks for
                 this identifier by name. -->
            <key>UTTypeIdentifier</key>
            <string>com.selenehyun.flowpeek.mermaid</string>
            <key>UTTypeDescription</key>
            <string>Mermaid Diagram</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
                <string>public.source-code</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mmd</string>
                    <string>mermaid</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <!-- Double-clicking a Mermaid file opens the preview rather than a text editor. Role
                 Viewer, because FlowPeek does not edit: it draws what the file says and leaves the
                 file alone. Owner rank because FlowPeek is the app that declares this type; anyone
                 who would rather edit can say so once in Get Info. -->
            <key>CFBundleTypeName</key>
            <string>Mermaid Diagram</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.selenehyun.flowpeek.mermaid</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
