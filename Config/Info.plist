<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>FlowPeek</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleLocalizations</key>
    <array><string>en</string><string>ko</string></array>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 FlowPeek</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- GitHub redirects releases/latest/download/<asset> to the newest release, so this URL is
         stable while the release workflow re-uploads appcast.xml on every tag. No extra hosting. -->
    <key>SUFeedURL</key>
    <string>https://github.com/FlowPeek/flowpeek/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>JxNKL7N4ydZGNSFrjODUHBpt+746seri2LLtfnVxQgk=</string>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <!-- macOS ships no type for a Mermaid file, so FlowPeek declares one. Conforming to
                 plain text keeps every editor able to open it; the Quick Look extension asks for
                 this identifier by name. -->
            <key>UTTypeIdentifier</key>
            <string>com.selenehyun.flowpeek.mermaid</string>
            <key>UTTypeDescription</key>
            <string>Mermaid Diagram</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
                <string>public.source-code</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mmd</string>
                    <string>mermaid</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
